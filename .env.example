# EarthTrend backend environment configuration.
# Copy this file to `.env` at the repository root and adjust as needed.

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
APP_VERSION=1.0.0
ANALYSIS_ENGINE_VERSION=1.0.0

# --- HTTP server -----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins. Use * only for local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- NASA POWER ------------------------------------------------------------
POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal
POWER_COMMUNITY=SB
POWER_TIMEOUT_SECONDS=30
POWER_MAX_RETRIES=3
POWER_RETRY_BACKOFF_SECONDS=1.5

# --- Cache -----------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=604800

# --- Demonstration fallback ------------------------------------------------
# When true, bundled real NASA POWER snapshots are served if live retrieval
# fails. Results are always labelled retrieval_mode="demo".
ALLOW_DEMO_FALLBACK=true

# --- Persistence -----------------------------------------------------------
# SQLite by default; swap for a PostgreSQL URL to scale out.
DATABASE_URL=sqlite:///./data/earthtrend.db

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Optional geospatial context (NASADEM / ESA WorldCover) ----------------
GEOSPATIAL_ENABLED=true
# NASADEM_PATH=C:/data/nasadem/nasadem.tif
# WORLDCOVER_PATH=C:/data/worldcover/worldcover.tif
